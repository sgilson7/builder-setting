 "code": {
  "post": {"file": "web/notes.js", "first": 10, "lines": [
   "async function save(note) {",
   "  const body = JSON.stringify(note);",
   "  const r = await fetch(\"/notes\", {method: \"POST\", body});",
   "  return (await r.json()).id;",
   "}"]},
  "handler": {"file": "server/notes.py", "first": 20, "lines": [
   "def post_note(req):",
   "    note = validate(req.json())",
   "    nid = db.insert(note)",
   "    return {\"id\": nid}"]}
 }
