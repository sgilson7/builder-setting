{
  "about": "One palette for the Manim renders and the deck's player. The colours come from two decks built alongside Builder, the SnapClass guide's FlowScene engine and the MerryQuery deck, by way of Manim Lab. tools/manim/theme.py writes deck/manim/theme.css from this file; the renderer reads it directly. Text sizes are SVG pixels in the scene's own units. Change the palette here, run theme.py, and render again: every manifest goes stale until you do. Manim Calc: panel is Manim's black in both themes, the render background (CM-Q5); plain, carry, borrow, struck, place, answer and focus are the stage's tones, Manim Community's standard colours, matching web/style.css.",
  "fonts": {
    "body": {
      "family": "Public Sans",
      "file": "deck/fonts/PublicSans-wght.ttf",
      "licence": "deck/fonts/PublicSans-OFL.txt"
    },
    "mono": {
      "family": "JetBrains Mono",
      "file": "deck/fonts/JetBrainsMono-wght.ttf",
      "licence": "deck/fonts/JetBrainsMono-OFL.txt"
    }
  },
  "render": {
    "scale": 2,
    "fps": 50
  },
  "text": {
    "node": {
      "font": "body",
      "px": 12.5,
      "weight": "normal",
      "colour": "fg"
    },
    "zone": {
      "font": "body",
      "px": 12,
      "weight": "semibold",
      "colour": "muted",
      "upper": true
    },
    "lab": {
      "font": "body",
      "px": 13,
      "weight": "bold",
      "colour": "fg"
    },
    "small": {
      "font": "body",
      "px": 11,
      "weight": "normal",
      "colour": "muted"
    },
    "mono": {
      "font": "mono",
      "px": 11,
      "weight": "normal",
      "colour": "muted"
    },
    "note": {
      "font": "body",
      "px": 13,
      "weight": "normal",
      "colour": "fg"
    }
  },
  "stroke": {
    "zone": 1,
    "edge": 1.5,
    "box": 1.2,
    "store": 2,
    "lit": 2.4,
    "live": 3,
    "mark": 1.5
  },
  "opacity": {
    "later": 22,
    "live": 55
